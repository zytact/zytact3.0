{
    "name": "zytact3.0",
    "version": "0.1.0",
    "private": true,
    "scripts": {
        "dev": "next dev",
        "build": "next build",
        "typecheck": "tsc --noEmit",
        "start": "next start",
        "lint": "eslint",
